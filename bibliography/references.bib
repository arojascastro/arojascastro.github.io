@incollection{rojas_castro_mapping_2025,
	address = {Oxon \& New York},
	title = {Mapping {Early} {Modern} {Hispanic} {Mythological} {Poems} with {Recogito}},
	isbn = {978-1-003-39377-1},
	abstract = {This chapter focuses on literary cartography applied to Early Modern Hispanic mythological poems. Our aim is to challenge the idea that modern geography is not present in many texts of the period, especially if they are mythological, because it presupposes a fictional representation of space and a predominance of the expressive function of language. For this purpose, we have used a corpus of 25 mythological poems (150,746 words) and a web application called Recogito to annotate places and visualise them on an interactive map. This chapter reflects on the encountered challenges, including lower than desired accuracy in named entity recognition (NER), difficulties selecting appropriate gazetteers, manual georesolution, and limited data visualization. Despite these issues, the project successfully annotated 741 place mentions, predominantly in southern Europe. The study concludes that the world represented in these poems is mostly classical, with a mix of modern places, and suggests future comparisons with classical poets like Ovid or epic poems to gain deeper insights into the geographical perspectives of the era.},
	language = {en},
	booktitle = {Digital {Humanities} in {Medieval} and {Early} {Modern} {Spanish} {Texts}},
	publisher = {Routledge},
	author = {Rojas Castro, Antonio},
	editor = {González Zalacain, Roberto J. and Vaamonde, Gael},
	year = {2025},
	pages = {101--117}
}


@misc{keith_computational_2024,
	title = {Computational {Analysis} of {Gender} {Depiction} in the {Comedias} of {Calderón} de la {Barca}},
	url = {http://arxiv.org/abs/2411.03895},
	doi = {10.48550/arXiv.2411.03895},
	abstract = {In theatre, playwrights use the portrayal of characters to explore culturally based gender norms. In this paper, we develop quantitative methods to study gender depiction in the non-religious works (comedias) of Pedro Calder{\textbackslash}'on de la Barca, a prolific Spanish 17th century author. We gather insights from a corpus of more than 100 plays by using a gender classifier and applying model explainability (attribution) methods to determine which text features are most influential in the model's decision to classify speech as 'male' or 'female', indicating the most gendered elements of dialogue in Calder{\textbackslash}'on's comedias in a human accessible manner. We find that female and male characters are portrayed differently and can be identified by the gender prediction model at practically useful accuracies (up to f=0.83). Analysis reveals semantic aspects of gender portrayal, and demonstrates that the model is even useful in providing a relatively accurate scene-by-scene prediction of cross-dressing characters.},
	language = {en},
	urldate = {2024-11-07},
	publisher = {arXiv},
	author = {Keith, Allison and Rojas Castro, Antonio and Padó, Sebastian},
	month = nov,
