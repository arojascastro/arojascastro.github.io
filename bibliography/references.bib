@misc{rojas_castro_caldracor_2025,
	title = {{CalDraCor} {Jupyter} {Notebooks} -- {Network} {Analysis}},
	url = {https://zenodo.org/doi/10.5281/zenodo.17158293},
	doi = {10.5281/ZENODO.17158293},
	abstract = {This dataset contains a curated collection of Jupyter Notebooks developed for the CalDraCor project (Calderón Drama Corpus) and related DraCor corpora. The notebooks combine TEI-XML parsing with computational literary studies and network analysis methods to study early modern Spanish drama. The collection addresses multiple research questions around character roles, gender distribution, and dramaturgical archetypes such as the gracioso or travestido. Some notebooks work directly with local TEI files, while others rely on the DraCor API.

The notebooks work with two main data sources: local TEI files from the CalDraCor repository and selected endpoints of the DraCor API. They require Python 3.10 or higher and a standard data science environment, including Jupyter Notebook/Lab and widely used libraries such as pandas, numpy, matplotlib, networkx, requests, lxml, and tqdm. Internet access is needed for API queries, while analyses based on CalDraCor run entirely on local TEI input.},
	urldate = {2026-03-03},
	publisher = {Zenodo},
	author = {Rojas Castro, Antonio},
	collaborator = {Ehrlicher, Hanno},
	month = sep,
	year = {2025},
	keywords = {Theater, Calderón de la Barca, Computational Literary Studies},
	language = {en}
}


