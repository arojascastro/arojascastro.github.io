@article{keith_investigating_2026,
	title = {Investigating features of the gracioso of {Pedro} {Calderón} de la {Barca}},
	volume = {11},
	issn = {2531-1786},
	url = {https://revistas.uned.es/index.php/RHD/article/view/48402},
	doi = {10.5944/rhd.vol.11.2026.48402},
	abstract = {The gracioso is one of the most prominent character archetypes of Siglo de Oro drama. However, a corpus-based large-scale empirical investigation of this archetype was missing so far. In our study, we analyze the portrayal of the gracioso in the works of Pedro Calderón de la Barca, one of the period’s most prominent playwrights. We base our investigation on four-character traits ascribed to the gracioso so far in qualitative research: 1) a central role in the character network; 2) distinctive linguistic simplicity; 3) breaking the fourth wall; and 4) having a humorous name. We describe how the gracioso character fits these traits, comparing him to all other characters and to the galán, whom he frequently accompanies. We then use a subset of features, combined with close reading and reference to the curated Calderón Digital Database to identify candidates for the gracioso label to enrich the CalDraCor database.},
	language = {en},
	urldate = {2026-09-01},
	journal = {Revista de Humanidades Digitales},
	author = {Keith, Allison and Rojas Castro, Antonio and Ehrlicher, Hanno and Padó, Sebastian},
	month = aug,
	year = {2026},
	keywords = {análisis de dramas, Análisis de redes, Análisis estilístico, Anotación, Datos enlazados en abierto, DraCor, Teatro del Siglo de Oro},
	pages = {68--91}
}


@article{ehrlicher_caldracor_2025,
	title = {{CalDraCor}: un corpus computacional para el estudio de la obra dramática de {Calderón} de la {Barca}},
	issn = {2162-5603},
	shorttitle = {{CalDraCor}},
	url = {https://journals.openedition.org/jtei/6996},
	doi = {10.4000/167ih},
	abstract = {Calderón Drama Corpus (CalDraCor) es un corpus de obras teatrales escritas por Pedro Calderón de la Barca preparadas para facilitar el análisis computacional. Compuesto por 205 piezas teatrales, el corpus representa un esfuerzo sin precedentes por digitalizar y estructurar el legado dramático de uno de los máximos exponentes del teatro español. Además, como parte de la plataforma DraCor, que conecta textos dramáticos de diversos idiomas y tradiciones, CalDraCor permite a los investigadores estudiar las obras de Calderón no solo como literatura, sino como sistemas complejos de personajes, diálogos y patrones lingüísticos, y permite comparaciones con otros textos dramáticos de la infraestructura digital. Esta nota describe el origen y evolución de CalDraCor, el tipo de datos que contiene, su impacto en la investigación, la política de datos abiertos llevada a cabo y los principios de normalización.},
	language = {es},
	number = {19},
	urldate = {2026-05-12},
	journal = {Journal of the Text Encoding Initiative},
	publisher = {Text Encoding Initiative Consortium},
	author = {Ehrlicher, Hanno and Rojas Castro, Antonio},
	month = oct,
	year = {2025},
	keywords = {Análisis computacional, Corpus, Digitalización, DraCor, Patrones lingüísticos, Pedro Calderón de la Barca, Teatro}
}


@article{keith_computation_2026,
	title = {A {Computation} {Analysis} of {Character} {Archetypes} in the {Works} of {Calderón} de la {Barca}},
	volume = {5},
	issn = {2940-1348},
	url = {https://jcls.io/article/id/4167/},
	doi = {10.48694/jcls.4167},
	abstract = {The Siglo de Oro period of Spanish theater was marked by a rapid increase of production of theatrical pieces. These plays used clear patterns, notably for genre, plot and character, even though there were no explicit drama conventions. Our study aims at characterizing such conventions in the work of Calderón de la  Barca. We investigate the portrayal of character archetypes based on character speech, adopting a scalable reading approach that employs machine learning to aggregate empirical evidence from a large number of Calderón's works. Concretely, we develop a neural network model to predict the six main character archetypes. We analyze the predictions of this model, inspect the lexical material that determines these predictions, and visualize the representations that the model learns. We find that the model predicts character archetypes with some accuracy (f1 = 0.47), and that some character archetypes, like criadas, are more standardized than others, like reyes.},
	language = {en},
	number = {1},
	urldate = {2026-04-06},
	journal = {Journal of Computational Literary Studies},
	publisher = {Universitäts- und Landesbibliothek Darmstadt},
	author = {Keith, Allison and Rojas Castro, Antonio and Jung, Kerstin and Ehrlicher, Hanno and Padó, Sebastian},
	month = apr,
	year = {2026}
}


@article{keith_towards_2025,
	title = {Towards {Computational} {Analysis} of {Gender} {Depiction} in the {Comedias} of {Calderón} de la {Barca}},
	volume = {4},
	issn = {2940-1348},
	url = {https://jcls.io/article/id/4055/},
	doi = {10.48694/jcls.4055},
	abstract = {In theatre, playwrights use the portrayal of characters to explore culturally based gender norms. In this paper, we develop quantitative methods to study gender depiction in the non-religious works (comedias) of Pedro Calderón de la Barca, a prolific Spanish 17th century author. We gather insights from a corpus of more than 100 plays by using a gender classifier and applying model explainability (attribution) methods to determine which text features are most influential in the model’s decision to classify speech as ‘male’ or ‘female’, indicating the most gendered elements of dialogue in Calderón's comedias in a manner accessible to humans. We find that the classifier picks up the male/female distinction mostly successfully (up to f=0.83), yields semantic aspects of gender portrayal, and demonstrates that the model is even useful in providing a relatively accurate scene-by-scene prediction of cross-dressing characters.},
	language = {en},
	number = {1},
	urldate = {2025-12-08},
	journal = {Journal of Computational Literary Studies},
	publisher = {Universitäts- und Landesbibliothek Darmstadt},
	author = {Keith, Allison and Rojas Castro, Antonio and Ehrlicher, Hanno and Jung, Kerstin and Padó, Sebastian},
	month = nov,
	year = {2025}
}


